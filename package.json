{
  "name": "purranormal-activity",
  "version": "0.14.15",
  "private": true,
  "engines": {
    "node": ">=26.13.1"
  },
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "preview": "vite preview",
    "deploy": "pnpm run build:start && wrangler deploy --config dist/server/wrangler.json",
    "dev": "pnpm run increase && vite dev",
    "build": "pnpm run build:start",
    "build:start": "vite build",
    "start": "vite preview",
    "cf-typegen": "wrangler types --config wrangler.jsonc",
    "lint": "biome check .",
    "format": "biome format . --write",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "generate": "pnpm run increase && npx drizzle-kit push",
    "increase": "npm --no-git-tag-version version patch",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,md,yml,yaml}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.123",
    "@libsql/client": "^0.18.0",
    "@tabler/icons-react": "^3.53.0",
    "ai": "^7.0.181",
    "classnames": "^2.5.1",
    "drizzle-orm": "^0.45.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-intersection-observer": "^11.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@cloudflare/vite-plugin": "1.70.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.7",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "^5.1.2",
    "drizzle-kit": "^0.31.11",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "8.3.8",
    "vitest": "^5.1.2",
    "wrangler": "4.168.0"
  }
}
